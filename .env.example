# Copy to .env and replace both empty secrets before starting.
# Prefer: sh scripts/setup.sh localhost
# ADMIN_PASSWORD >= 16 characters; INTERNAL_TOKEN >= 32 characters.
# Generate independent values with openssl rand -hex 24 and -hex 32.
# Hex avoids Compose interpolation and URL-escaping pitfalls.
ADMIN_PASSWORD=
INTERNAL_TOKEN=

# Hostname or IPv4 address only, with no scheme, port, path, or credentials.
# This is advertised to OBS, not a bind address.
PUBLIC_HOST=localhost
RTMP_PORT=1935
WEB_PORT=8080

# Safe local defaults. For remote OBS, bind RTMP to the host's VPN IP.
# For a remote HTTPS proxy, bind web to an appropriate private interface.
WEB_BIND=127.0.0.1
RTMP_BIND=127.0.0.1
# Set true when the browser reaches the app through HTTPS.
COOKIE_SECURE=false

# Record each stream automatically on connection, including after backend restart.
# Set false for manual-only recording. Manual Stop lasts for the current connection.
AUTO_RECORD=true

MIN_FREE_GB=2
FACE_RETENTION_DAYS=7
MAX_FACES=2000
MATCH_THRESHOLD=0.5
DETECTION_THRESHOLD=0.85
ANALYSIS_FPS=2
